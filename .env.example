# Firebase Configuration
# Get these values from your Firebase project settings
# https://console.firebase.google.com/

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth Client IDs
# Get these from Google Cloud Console > APIs & Services > Credentials
# You need separate OAuth 2.0 Client IDs for each platform:
# - Web application (for Expo Go / web)
# - iOS (for native iOS builds)
# - Android (for native Android builds)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Local Firebase Emulator Suite (see docs/TESTING.md). When enabled the app ignores
# the EXPO_PUBLIC_FIREBASE_* values above and talks to the local emulators only.
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# Only needed for a physical device on your LAN (auto-detected from Metro otherwise):
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# AdMob (free editions only; see docs/MONETIZATION.md). App and ad unit IDs are in app.config.js and
# src/monetization/ads.ts; development builds always use Google's test ad units.
# Release build with test ads (internal QA): EXPO_PUBLIC_ADMOB_TEST_ADS=true
# Dev only: instant fake purchases instead of the App Store / Google Play (web always uses the fake store)
# EXPO_PUBLIC_FAKE_STORE=true
# Dev only: force the lite edition in a web/dev build (iOS is always lite; Android lite = APP_VARIANT=lite)
# EXPO_PUBLIC_EDITION=lite
