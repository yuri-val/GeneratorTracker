{
  "name": "generatortracker",
  "version": "2.5.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:emu": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true expo start",
    "web:emu": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true expo start --web",
    "emulators": "npx -y firebase-tools@14 emulators:start --only auth,firestore --project demo-generatortracker",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:emu": "FIREBASE_EMULATOR=1 npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-generatortracker \"playwright test\"",
    "test:native:ios": "maestro test .maestro/ios",
    "test:native:android": "maestro test .maestro/android",
    "check": "npm run typecheck && npm test",
    "prepare": "husky",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-generatortracker \"jest -c jest.rules.config.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.4.0",
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.8.0",
    "i18next": "^25.8.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
    "react-native": "0.86.3",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-gifted-charts": "^1.4.73",
    "react-native-pager-view": "8.0.2",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.2.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.61.1",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
