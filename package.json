{
  "name": "generatortracker",
  "version": "2.4.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:emu": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true expo start",
    "web:emu": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true expo start --web",
    "emulators": "npx -y firebase-tools@14 emulators:start --only auth,firestore --project demo-generatortracker",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:emu": "FIREBASE_EMULATOR=1 npx -y firebase-tools@14 emulators:exec --only auth,firestore --project demo-generatortracker \"playwright test\"",
    "check": "npm run typecheck && npm test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.8.0",
    "i18next": "^25.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "^0.81.5",
    "react-native-gifted-charts": "^1.4.73",
    "react-native-pager-view": "6.9.1",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.2.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/metro-config": "0.83.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.3"
  },
  "private": true
}
