{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "credentialsSource": "local",
        "autoIncrement": true
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "autoIncrement": true
      }
    },
    "preview-lite": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "lite"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "credentialsSource": "local",
        "autoIncrement": true
      }
    },
    "production-lite": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "lite"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local",
        "autoIncrement": true
      }
    },
    "development-sim": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./credentials/android/play-service-account.json"
      },
      "ios": {
        "ascAppId": "6819560707"
      }
    },
    "production-lite": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./credentials/android/play-service-account.json"
      }
    }
  }
}
